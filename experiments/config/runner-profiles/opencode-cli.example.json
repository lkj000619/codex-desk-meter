{
  "provider": "opencode",
  "product": "opencode-cli",
  "interface": "cli",
  "agent_version": "1.18.30",
  "model": "opencode/muse-spark-1.3-contributor-free",
  "model_slug": "muse-spark-1-3-contributor-free",
  "reasoning": "provider-default-no-variant-selected",
  "branch_owner": "opencode",
  "branch_product": "cli",
  "cohort": "version-2-end-to-end-v1",
  "adapter": "opencode",
  "argv": [
    "<verified-opencode-executable>",
    "run",
    "--pure",
    "--format",
    "json",
    "--model",
    "{model}"
  ],
  "version_argv": [
    "<verified-opencode-executable>",
    "--version"
  ],
  "sandbox_policy": "os-read-isolation-not-verified",
  "approval_policy": "explicit-policy-required-before-run",
  "network_mode": "offline-fixture",
  "settings_inventory": {
    "skills": "operator-check-required",
    "mcp": "operator-check-required",
    "memory": "operator-check-required",
    "user_instructions": "operator-check-required",
    "cache": "operator-check-required",
    "routing": "operator-check-required"
  }
}
