{
  "policy_version": 1,
  "allow": [
    "command(dir)",
    "command(pwd)",
    "command(Get-ChildItem)",
    "command(Get-Location)",
    "command(git status)",
    "command(git diff)",
    "command(idf.py set-target esp32s3)",
    "command(idf.py build)",
    "command(regex:^python(?:\\.exe)? -m unittest(?: .*)?$)"
  ]
}
