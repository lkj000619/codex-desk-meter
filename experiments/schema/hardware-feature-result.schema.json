{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-desk-meter.local/schema/hardware-feature-result.schema.json",
  "title": "Codex Desk Meter hardware feature result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "experiment_id",
    "candidate_features",
    "selected_feature_id",
    "selection_rationale",
    "rejected_feature_ids",
    "implementation",
    "core_requirements",
    "metrics",
    "failures",
    "unresolved_risks"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9-]+$" },
    "experiment_id": { "const": "version-2-hardware-autonomy-v1" },
    "candidate_features": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "hardware_resource", "user_value", "implementation_cost", "risk", "verification_plan"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "hardware_resource": { "type": "string", "minLength": 1 },
          "user_value": { "type": "string", "minLength": 1 },
          "implementation_cost": { "type": "string", "minLength": 1 },
          "risk": { "type": "string", "minLength": 1 },
          "verification_plan": { "type": "string", "minLength": 1 }
        }
      }
    },
    "selected_feature_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "selection_rationale": { "type": "string", "minLength": 1 },
    "rejected_feature_ids": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "commit", "build", "automated_tests", "hardware_test_plan", "hardware_result"],
      "properties": {
        "files": { "type": "array", "items": { "type": "string" } },
        "commit": { "type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{7,64}$" },
        "build": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "command", "notes"],
          "properties": {
            "status": { "enum": ["pass", "fail", "not_run", "timeout"] },
            "command": { "type": "string", "minLength": 1 },
            "notes": { "type": "string" }
          }
        },
        "automated_tests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "commands", "notes"],
          "properties": {
            "status": { "enum": ["pass", "partial", "fail", "not_run", "timeout"] },
            "commands": { "type": "array", "items": { "type": "string" } },
            "notes": { "type": "string" }
          }
        },
        "hardware_test_plan": { "type": "string", "minLength": 1 },
        "hardware_result": { "enum": ["pass", "partial", "fail", "not_run", "blocked"] }
      }
    },
    "core_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["C1", "C2", "C3", "C4", "C5", "C6", "C7", "C8"],
      "properties": {
        "C1": { "$ref": "#/$defs/requirementResult" },
        "C2": { "$ref": "#/$defs/requirementResult" },
        "C3": { "$ref": "#/$defs/requirementResult" },
        "C4": { "$ref": "#/$defs/requirementResult" },
        "C5": { "$ref": "#/$defs/requirementResult" },
        "C6": { "$ref": "#/$defs/requirementResult" },
        "C7": { "$ref": "#/$defs/requirementResult" },
        "C8": { "$ref": "#/$defs/requirementResult" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovery_started_at", "discovery_ended_at", "tokens", "notes"],
      "properties": {
        "discovery_started_at": { "type": ["string", "null"], "format": "date-time" },
        "discovery_ended_at": { "type": ["string", "null"], "format": "date-time" },
        "tokens": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input", "output", "cached", "reasoning", "total"],
          "properties": {
            "input": { "type": ["integer", "null"], "minimum": 0 },
            "output": { "type": ["integer", "null"], "minimum": 0 },
            "cached": { "type": ["integer", "null"], "minimum": 0 },
            "reasoning": { "type": ["integer", "null"], "minimum": 0 },
            "total": { "type": ["integer", "null"], "minimum": 0 }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "failures": { "type": "array", "items": { "type": "string" } },
    "unresolved_risks": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "requirementResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": { "enum": ["pass", "partial", "fail", "not_run", "blocked"] },
        "evidence": { "type": "string", "minLength": 1 }
      }
    }
  }
}
