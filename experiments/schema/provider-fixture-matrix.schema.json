{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-desk-meter.local/schema/provider-fixture-matrix.schema.json",
  "title": "Codex Desk Meter provider fixture expectation matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reference_time", "fixtures"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "reference_time": {
      "type": "string",
      "format": "date-time"
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fixture"
      }
    }
  },
  "$defs": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "expected", "error_code"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)[^\\\\]+$"
        },
        "expected": {
          "enum": ["valid", "invalid"]
        },
        "error_code": {
          "type": ["string", "null"],
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_.-]*$"
        }
      }
    }
  }
}
