{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-desk-meter.local/schema/cdm-frame.schema.json",
  "title": "Codex Desk Meter cdm/1 host-to-device frame",
  "$comment": "Each payload.usage item is validated independently by usage-snapshot.schema.json before framing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "sequence",
    "sent_at",
    "payload",
    "integrity"
  ],
  "properties": {
    "protocol": {
      "const": "cdm/1"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "sent_at": {
      "$ref": "#/$defs/timestamp"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usage",
        "global_resets"
      ],
      "properties": {
        "usage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/usageSnapshot"
          }
        },
        "global_resets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/globalReset"
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "crc32"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9A-F]{8}$"
        }
      }
    }
  },
  "$defs": {
    "usageSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "snapshot_id",
        "provider_id",
        "agent_id",
        "host_id",
        "model_id",
        "account_profile_id",
        "source_kind",
        "metric_kind",
        "unit",
        "status",
        "observed_at",
        "windows",
        "stale",
        "last_good_at",
        "error_code",
        "error_reason"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "snapshot_id": {
          "$ref": "#/$defs/identifier"
        },
        "provider_id": {
          "$ref": "#/$defs/identity"
        },
        "agent_id": {
          "$ref": "#/$defs/identityOrNull"
        },
        "host_id": {
          "$ref": "#/$defs/identityOrNull"
        },
        "model_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "account_profile_id": {
          "$ref": "#/$defs/identityOrNull"
        },
        "source_kind": {
          "enum": [
            "fixture",
            "local_runtime",
            "provider_api",
            "ide_telemetry",
            "unknown"
          ]
        },
        "metric_kind": {
          "enum": [
            "quota_window",
            "token_balance",
            "credits",
            "session_telemetry"
          ]
        },
        "unit": {
          "enum": [
            "percent",
            "token",
            "credit",
            "unknown"
          ]
        },
        "status": {
          "enum": [
            "available",
            "unavailable",
            "unsupported",
            "unauthorized",
            "error",
            "stale"
          ]
        },
        "observed_at": {
          "$ref": "#/$defs/timestampOrNull"
        },
        "windows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quotaWindow"
          }
        },
        "stale": {
          "type": "boolean"
        },
        "last_good_at": {
          "$ref": "#/$defs/timestampOrNull"
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_.-]*$"
        },
        "error_reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "unavailable",
                  "unsupported",
                  "unauthorized",
                  "error",
                  "stale"
                ]
              }
            }
          },
          "then": {
            "required": [
              "error_code",
              "error_reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "stale"
              }
            }
          },
          "then": {
            "properties": {
              "stale": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "quotaWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_id",
        "label",
        "used_units",
        "remaining_units",
        "limit_units",
        "unit",
        "percent_used",
        "percent_remaining",
        "resets_at"
      ],
      "properties": {
        "window_id": {
          "$ref": "#/$defs/identifier"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "used_units": {
          "$ref": "#/$defs/numberOrNull"
        },
        "remaining_units": {
          "$ref": "#/$defs/numberOrNull"
        },
        "limit_units": {
          "$ref": "#/$defs/numberOrNull"
        },
        "unit": {
          "enum": [
            "percent",
            "token",
            "credit",
            "unknown"
          ]
        },
        "percent_used": {
          "$ref": "#/$defs/percentOrNull"
        },
        "percent_remaining": {
          "$ref": "#/$defs/percentOrNull"
        },
        "resets_at": {
          "$ref": "#/$defs/timestampOrNull"
        },
        "reset_status": {
          "enum": [
            "unknown",
            "scheduled",
            "expired"
          ]
        }
      }
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "identity": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "identityOrNull": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "numberOrNull": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "percentOrNull": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "timestampOrNull": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "globalReset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source",
        "captured_at",
        "latest_reset_at",
        "forecast_24h_percent",
        "forecast_48h_percent",
        "forecast_is_schedule",
        "stale",
        "error_code"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "captured_at": {
          "$ref": "#/$defs/timestamp"
        },
        "latest_reset_at": {
          "$ref": "#/$defs/timestampOrNull"
        },
        "forecast_24h_percent": {
          "$ref": "#/$defs/percentOrNull"
        },
        "forecast_48h_percent": {
          "$ref": "#/$defs/percentOrNull"
        },
        "forecast_is_schedule": {
          "const": false
        },
        "stale": {
          "type": "boolean"
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_.-]*$"
        }
      }
    }
  }
}
