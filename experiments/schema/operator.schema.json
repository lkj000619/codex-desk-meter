{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["phase", "status", "reason", "repetition", "cohort", "seed", "exit_code", "delivered_prompt_sha256", "local_base_commit", "evidence"],
  "properties": {
    "phase": {"enum": ["pilot", "benchmark"]},
    "status": {"enum": ["prepared", "running", "completed", "aborted", "timeout", "environment_failed"]},
    "reason": {"type": ["string", "null"]},
    "repetition": {"type": "integer", "minimum": 1, "maximum": 99},
    "cohort": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "exit_code": {"type": ["integer", "null"]},
    "delivered_prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "local_base_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "evidence": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
  }
}
