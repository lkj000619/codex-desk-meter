{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["provider", "product", "interface", "agent_version", "model", "model_slug", "reasoning", "branch_owner", "branch_product", "cohort", "adapter", "argv", "version_argv", "sandbox_policy", "approval_policy", "network_mode", "settings_inventory"],
  "properties": {
    "provider": {"type": "string", "minLength": 1},
    "product": {"type": "string", "minLength": 1},
    "interface": {"const": "cli"},
    "agent_version": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "model_slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "reasoning": {"type": "string", "minLength": 1},
    "branch_owner": {"type": "string", "minLength": 1},
    "branch_product": {"type": "string", "minLength": 1},
    "cohort": {"type": "string", "minLength": 1},
    "adapter": {"enum": ["codex", "gemini", "opencode", "antigravity"]},
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "version_argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "sandbox_policy": {"type": "string", "minLength": 1},
    "approval_policy": {"type": "string", "minLength": 1},
    "network_mode": {"enum": ["offline-fixture", "public-read", "live-integration"]},
    "settings_inventory": {"type": "object", "required": ["skills", "mcp", "memory", "user_instructions", "cache", "routing"], "additionalProperties": {"type": "string"}}
  }
}
